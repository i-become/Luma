<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.luma.system.mapper.SysPostMapper">

    <resultMap id="BaseResultMap" type="com.luma.system.domain.entity.SysPost">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="code" column="code" jdbcType="VARCHAR"/>
            <result property="postName" column="post_name" jdbcType="VARCHAR"/>
            <result property="sort" column="sort" jdbcType="INTEGER"/>
            <result property="status" column="status" jdbcType="TINYINT"/>
            <result property="createBy" column="create_by" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateBy" column="update_by" jdbcType="VARCHAR"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="remark" column="remark" jdbcType="VARCHAR"/>
            <result property="tenantId" column="tenant_id" jdbcType="BIGINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,code,post_name,
        sort,status,create_by,
        create_time,update_by,update_time,
        remark
    </sql>

    <select id="selectPostListByUserId" parameterType="java.lang.Long" resultType="com.luma.system.domain.vo.SysPostListResp" >
        select p.id, p.code, p.post_name from sys_post p
        inner join sys_user_post up on p.id = up.post_id
        where up.user_id = #{userId}
        order by p.sort
    </select>

</mapper>
