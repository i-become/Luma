<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.luma.system.mapper.SysPostMapper">

    <select id="selectPostListByUserId" parameterType="java.lang.Long" resultType="com.luma.system.domain.vo.SysPostListResp" >
        select p.id, p.code, p.post_name from sys_post p
        inner join sys_user_post up on p.id = up.post_id
        where up.user_id = #{userId}
        order by p.sort
    </select>

</mapper>
